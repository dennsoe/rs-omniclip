{
  "name": "rs-omnitools",
  "version": "2.1.1",
  "description": "RS OmniTools - Super App desktop: pemrosesan massal video pendek (pembersih metadata, peningkat, pengunduh, pemotong, watermark, kompresor WhatsApp) + analisis performa kampanye Meta Ads vs Shopee Affiliate.",
  "main": "./out/main/index.js",
  "author": "RS STUDIO",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:extension": "node scripts/build-extension.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "extract-zip": "^2.0.1",
    "ffbinaries": "^1.1.6",
    "https-proxy-agent": "^7.0.6",
    "papaparse": "^5.6.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "socks-proxy-agent": "^8.0.5"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "^20.19.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-dropzone": "^20.1.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "4.1.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "id.rsstudio.omnitools",
    "productName": "RS OmniTools",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "extensions/rs-omni-cookie-capturer",
        "to": "rs-omni-cookie-capturer"
      },
      {
        "from": "extensions/rs-omni-cookie-capturer.zip",
        "to": "rs-omni-cookie-capturer.zip"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "RS-OmniTools-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "RS-OmniTools-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "RS-OmniTools-${version}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "RS-OmniTools-${version}-${arch}-portable.${ext}"
    },
    "afterSign": "scripts/afterSign.js",
    "publish": {
      "provider": "github",
      "owner": "dennsoe",
      "repo": "rs-omnitools"
    }
  }
}
